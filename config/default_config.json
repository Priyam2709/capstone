{
  "project_info": {
    "name": "Explainable AI-Based Diabetic Retinopathy Screening System for Rural India",
    "problem_id": "SIH26038",
    "version": "1.0.0",
    "institution": "University Capstone Project & Smart India Hackathon",
    "target_domain": "Rural Health Centers & Mobile Eye Screening Camps"
  },
  "paths": {
    "root": ".",
    "raw_data_dir": "data/raw",
    "processed_data_dir": "data/processed",
    "labels_dir": "data/labels",
    "models_dir": "models",
    "checkpoints_dir": "models/checkpoints",
    "results_dir": "results",
    "logs_dir": "results/logs",
    "reports_dir": "results/reports",
    "visualizations_dir": "results/visualizations"
  },
  "dataset": {
    "supported_datasets": ["APTOS", "EyePACS", "IDRiD", "Messidor"],
    "active_dataset": "APTOS",
    "split_ratios": {
      "train": 0.70,
      "validation": 0.15,
      "test": 0.15
    },
    "random_seed": 42,
    "stratified": true
  },
  "image": {
    "target_size": [224, 224, 3],
    "color_space": "RGB",
    "normalize_range": [0.0, 1.0],
    "crop_black_borders": true,
    "circular_mask": true
  },
  "quality_assessment": {
    "thresholds": {
      "blur_min_laplacian_variance": 100.0,
      "brightness_min": 40.0,
      "brightness_max": 215.0,
      "contrast_min_rms": 25.0,
      "noise_max_std": 20.0,
      "sharpness_min_tenengrad": 150.0
    },
    "weights": {
      "blur": 0.25,
      "brightness": 0.20,
      "contrast": 0.20,
      "noise": 0.15,
      "sharpness": 0.20
    },
    "score_thresholds": {
      "good": 75.0,
      "needs_enhancement": 50.0
    },
    "categories": ["Good", "Needs Enhancement", "Retake Image"]
  },
  "preprocessing": {
    "pipeline": ["median_filter", "illumination_correction", "clahe", "contrast_stretching"],
    "clahe_clip_limit": 2.0,
    "clahe_tile_grid_size": [8, 8],
    "median_filter_kernel": [3, 3],
    "gamma_correction": 1.1
  },
  "model": {
    "supported_architectures": ["resnet18", "resnet50", "efficientnetb0", "mobilenetv2"],
    "selected_architecture": "resnet50",
    "num_classes": 5,
    "class_names": [
      "0 - No DR",
      "1 - Mild NPDR",
      "2 - Moderate NPDR",
      "3 - Severe NPDR",
      "4 - Proliferative DR"
    ],
    "pretrained_weights": "imagenet",
    "dropout_rate": 0.4
  },
  "training": {
    "batch_size": 32,
    "max_epochs": 30,
    "initial_learning_rate": 0.0001,
    "optimizer": "adam",
    "adam_beta1": 0.9,
    "adam_beta2": 0.999,
    "l2_regularization": 0.0001,
    "lr_scheduler": "piecewise",
    "lr_drop_factor": 0.1,
    "lr_drop_period": 10,
    "early_stopping": {
      "enabled": true,
      "patience": 5,
      "metric": "ValidationLoss"
    },
    "checkpoint": {
      "save_best_only": true,
      "monitor_metric": "ValidationLoss"
    },
    "validation_frequency": 50,
    "data_augmentation": {
      "random_horizontal_flip": true,
      "random_vertical_flip": true,
      "random_rotation_range": [-25, 25],
      "random_scale_range": [0.9, 1.1],
      "random_shear_range": [-5, 5]
    }
  },
  "explainability": {
    "method": "Grad-CAM",
    "target_layer": "auto",
    "colormap": "jet",
    "overlay_alpha": 0.5,
    "highlight_lesions": true,
    "generate_clinical_text": true,
    "export_format": "png"
  },
  "reporting": {
    "organization": "Rural Community Eye Care Initiative - SIH26038",
    "export_format": "pdf",
    "include_original": true,
    "include_enhanced": true,
    "include_gradcam": true,
    "include_recommendation": true,
    "referral_threshold_stage": 2
  },
  "rural_deployment": {
    "offline_mode": true,
    "field_worker_id": "RURAL-ASHA-001",
    "camp_location": "Primary Health Centre, Wardha District",
    "language": "en",
    "save_telemetry": true
  }
}
